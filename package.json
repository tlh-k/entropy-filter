{
  "name": "entropy-filter",
  "version": "0.2.0",
  "description": "Entropy-based output filter for coding agents: keeps the lines that carry information, stores the rest locally (MCP + Claude Code plugin).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "entropy-filter": "dist/entropy-filter.mjs"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    ".antigravity-plugin",
    "mcp_config.json",
    "rules"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlh-k/entropy-filter.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "fixtures": "node scripts/fixtures.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  }
}
